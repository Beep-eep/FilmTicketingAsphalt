# Copy this file to .env (same folder) and fill in what you need.
# Every line is optional: with no .env the site runs locally exactly as before
# (MySQL FilmTicketing / test / 123456, emails printed in the terminal, demo payments).

# --- Database -----------------------------------------------------------------
# Leave DATABASE_URL empty to use your local MySQL (settings below).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DATABASE_URL=sqlite:///db.sqlite3          # zero-setup option for quick tests
DB_NAME=FilmTicketing
DB_USER=test
DB_PASSWORD=123456
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Django -------------------------------------------------------------------
DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=change-me-to-a-long-random-string    # required when DEBUG is false
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
CINEMA_TIME_ZONE=America/Los_Angeles
# CINEMA_NAME=Asphalt Cinema
# FRONTEND_URL=https://example.com     # only if links in emails should point somewhere fixed

# --- Payments (Stripe) ----------------------------------------------------------
# Empty = demo payments (no money moves). Test keys: https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...      # printed by `stripe listen`, or from the Dashboard webhook
# CURRENCY=usd

# --- Email ------------------------------------------------------------------------
# Empty = emails are printed in the runserver terminal (copy the link from there).
# Gmail (needs 2-Step Verification + an App Password: https://myaccount.google.com/apppasswords)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your16letterapppassword
# DEFAULT_FROM_EMAIL=Asphalt Cinema <you@gmail.com>
#
# Resend (HTTPS API, works on hosts that block SMTP such as Render's free plan)
# RESEND_API_KEY=re_...
# DEFAULT_FROM_EMAIL=Asphalt Cinema <tickets@your-verified-domain.com>
#
# REQUIRE_EMAIL_VERIFICATION=true

# --- Movie data -------------------------------------------------------------------
# TMDB_API_KEY=...                     # https://www.themoviedb.org/settings/api

# --- Booking rules ------------------------------------------------------------------
# MAX_SEATS_PER_ORDER=8
# SEAT_HOLD_MINUTES=10
# REFUND_CUTOFF_MINUTES=60
# AUTO_SCHEDULE_DAYS=7
